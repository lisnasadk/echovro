# ==============================================================================
# EchoVro Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your real credentials. NEVER commit .env!
# ==============================================================================

# ---- Twilio Voice / WebRTC Network Traversal ----
# Obtain from https://console.twilio.com (Account SID and Auth Token)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# ---- Server Port ----
PORT=8080

# ---- Database Configuration ----
# Embedded H2 (default for local test):
DATABASE_URL=jdbc:h2:file:./data/echovro;MODE=MySQL;DB_CLOSE_DELAY=-1
DB_USERNAME=sa
DB_PASSWORD=

# Production PostgreSQL / MySQL (e.g., on Render):
# DATABASE_URL=jdbc:postgresql://hostname:5432/echovro_db
# DB_USERNAME=echovro_db_user
# DB_PASSWORD=your_db_password

# ---- Security & JWT ----
# Must be at least 32 characters long
JWT_SECRET=your-32-byte-long-super-secret-key-for-jwt-signing

# ---- Allowed CORS Origins (Comma-separated) ----
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,https://echovrolive.vercel.app

# ---- Spotify API (Frontend PKCE & Optional Backend) ----
SPOTIFY_CLIENT_ID=4763676c31c944d7ac4bb1a9d9e4f95a
